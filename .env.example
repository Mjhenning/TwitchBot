# ── Twitch ──────────────────────────────────────────────
BOT_NAME=
CHANNEL_NAME=
CLIENT_ID=
CLIENT_SECRET=

# ── OBS WebSocket ───────────────────────────────────────
OBS_WS_URL=ws://192.168.1.x:4455
OBS_WS_PASSWORD=
OBS_SOURCE_NAME=Media_Playback

# ── VLC ─────────────────────────────────────────────────
VLC_HOST=http://localhost:8080
VLC_PASSWORD=

# ── Limusic Control API ─────────────────────────────────
# Enable it in Limusic under Settings → Integrations → Control API.
# Use 127.0.0.1 when Limusic runs on this PC, or its LAN IP when it runs elsewhere.
# The token is only shown in the Settings UI. Never commit it.
LIMUSIC_CONTROL_URL=http://192.168.1.x:27199
LIMUSIC_CONTROL_TOKEN=
SSR_MAX_DURATION_SECONDS=600 # max song request length in seconds

# ── Media Requests ──────────────────────────────────────
MR_REDEEM_ID=
MEDIA_QUEUE_DIR=/path/to/MediaQueue
MR_MAX_DURATION_SECONDS=60   # max redeemable clip length in seconds

# ── Glossels Redeem ─────────────────────────────────────
GLOSSELS_REDEEM_ID=

# ── Overlay Hub ─────────────────────────────────────────
# Port the shared OBS browser-source WS hub listens on. Every overlay source
# connects to this one port and selects its channel with ?overlay=<name>.
OVERLAY_WS_PORT=8420

# ── Glosso-thon Timer ───────────────────────────────────
# Bot-authoritative countdown on the overlay hub (channel "timer"). Gift subs
# add time automatically; mods control it with !timer toggle | add <min> | set <min>.
TIMER_START_MINUTES=60   # base countdown length when there is no saved state
TIMER_GIFT_MINUTES=6     # minutes added per gifted sub

# ── Socials ─────────────────────────────────────────────
DISCORD_LINK=
ITCH_LINK=
YT_LINK=
INSTA_LINK=

# ── Twitch Review Channel ───────────────────────────────
REWARD_REVIEW_CHANNEL=

# ── Favourite Shoutouts ─────────────────────────────────
# Path to the Discord bot's favourites JSON. Legacy string entries mean both
# platforms; object entries use type 0 (both), 1 (Discord only), 2 (Twitch only).
# Defaults to the sibling repo (../DiscordBot/Data/favourites.json); the bot
# throws a text shoutout when a favourited streamer first chats each stream.
FAVOURITES_FILE=

# ── Duels and Bin ──────────────────────────────────────
# Duel requests expire silently after DUEL_TTL_SECONDS (default 60). !bin recovery
# fires after a hidden random delay of BIN_RECOVERY_MIN_SECONDS to
# BIN_RECOVERY_MAX_SECONDS (default 45 to 90) and is never announced.
DUEL_TTL_SECONDS=60
BIN_RECOVERY_MIN_SECONDS=45
BIN_RECOVERY_MAX_SECONDS=90

# ── Debug ───────────────────────────────────────────────
DEBUG=false