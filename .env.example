# ── Twitch ──────────────────────────────────────────────
BOT_NAME=
CHANNEL_NAME=
CLIENT_ID=
CLIENT_SECRET=

# ── YouTube ─────────────────────────────────────────────
YOUTUBE_ACCESS_KEY=

# ── OBS WebSocket ───────────────────────────────────────
OBS_WS_URL=ws://192.168.1.x:4455
OBS_WS_PASSWORD=
OBS_SOURCE_NAME=Media_Playback

# ── VLC ─────────────────────────────────────────────────
VLC_HOST=http://localhost:8080
VLC_PASSWORD=

# ── Pear Desktop Music ──────────────────────────────────
PEAR_HOST=http://192.168.1.x
PEAR_PORT=26538
PEAR_ID=

# ── Media Requests ──────────────────────────────────────
MR_REDEEM_ID=
MEDIA_QUEUE_DIR=/path/to/MediaQueue

# ── Glossels Redeem ─────────────────────────────────────
GLOSSELS_REDEEM_ID=

# ── Top 10 Overlay ──────────────────────────────────────
# Port the OBS browser-source WS server listens on
TOP10_OVERLAY_PORT=8420

# ── Profile Overlay ─────────────────────────────────────
# Port the OBS user-profile browser-source WS server listens on
PROFILE_OVERLAY_PORT=8430

# ── Socials ─────────────────────────────────────────────
DISCORD_LINK=
ITCH_LINK=
YT_LINK=
INSTA_LINK=

# ── Twitch Review Channel ───────────────────────────────
REWARD_REVIEW_CHANNEL=

# ── Debug ───────────────────────────────────────────────
DEBUG=false
