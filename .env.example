# ── Twitch ──────────────────────────────────────────────
BOT_NAME=
CHANNEL_NAME=
CLIENT_ID=
CLIENT_SECRET=

# ── YouTube ─────────────────────────────────────────────
YOUTUBE_ACCESS_KEY=

# ── OBS WebSocket ───────────────────────────────────────
OBS_WS_URL=ws://192.168.1.x:4455
OBS_WS_PASSWORD=
OBS_SOURCE_NAME=Media_Playback

# ── VLC ─────────────────────────────────────────────────
VLC_HOST=http://localhost:8080
VLC_PASSWORD=

# ── Pear Desktop Music ──────────────────────────────────
PEAR_HOST=http://192.168.1.x
PEAR_PORT=26538
PEAR_ID=

# ── Media Requests ──────────────────────────────────────
MR_REDEEM_ID=
MEDIA_QUEUE_DIR=/path/to/MediaQueue
MR_MAX_DURATION_SECONDS=60   # max redeemable clip length in seconds

# ── Glossels Redeem ─────────────────────────────────────
GLOSSELS_REDEEM_ID=

# ── Overlay Hub ─────────────────────────────────────────
# Port the shared OBS browser-source WS hub listens on. Every overlay source
# connects to this one port and selects its channel with ?overlay=<name>.
OVERLAY_WS_PORT=8420

# ── Glosso-thon Timer ───────────────────────────────────
# Bot-authoritative countdown on the overlay hub (channel "timer"). Gift subs
# add time automatically; mods control it with !timer toggle | add <min> | set <min>.
TIMER_START_MINUTES=60   # base countdown length when there is no saved state
TIMER_GIFT_MINUTES=6     # minutes added per gifted sub

# ── Socials ─────────────────────────────────────────────
DISCORD_LINK=
ITCH_LINK=
YT_LINK=
INSTA_LINK=

# ── Twitch Review Channel ───────────────────────────────
REWARD_REVIEW_CHANNEL=

# ── Favourite Shoutouts ─────────────────────────────────
# Path to the Discord bot's favourites JSON (username -> go-live message).
# Defaults to the sibling repo (../DiscordBot/Data/favourites.json); the bot
# throws a text shoutout when a favourited streamer first chats each stream.
FAVOURITES_FILE=

# ── Debug ───────────────────────────────────────────────
DEBUG=false